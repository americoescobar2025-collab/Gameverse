# Uso local sin instalar un servidor de base de datos.
db.type=sqlite
db.path=database/gameverse.db

# Para cambiar a MySQL, usar db.type=mysql y completar estos valores.
db.mysql.url=jdbc:mysql://localhost:3306/gameverse_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
db.mysql.driver=com.mysql.cj.jdbc.Driver
db.mysql.user=root
db.mysql.password=
